# Chave da Meta Model API (https://api.meta.ai/v1)
MODEL_API_KEY=coloque_a_sua_chave_aqui

# URL base da API FastAPI para o front-end Next.js (opcional; por omissão http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Quotas diárias de chamadas aos modelos da Meta (/agente, /voz, /foto)
QUOTA_DIARIA_CONVIDADO=15
QUOTA_DIARIA_REGISTADO=40
QUOTA_DIARIA_GLOBAL=400

# Limite de criação de contas de demonstração por IP (/auth/demo)
AUTH_DEMO_MAX_POR_IP_HORA=5

# Limites de upload de ficheiros
UPLOAD_MAX_IMAGEM_BYTES=5242880
UPLOAD_MAX_AUDIO_BYTES=2097152
UPLOAD_MAX_AUDIO_SEGUNDOS=60

# Modo de manutenção de emergência (1 para ativar erro 503 nas rotas do modelo)
MODO_MANUTENCAO=0

# Períodos de retenção e limpeza automática de dados
RETENCAO_CONVIDADO_HORAS=24
RETENCAO_REGISTADO_DIAS=30

# Configurações de Produção
CORS_ORIGENS_PERMITIDAS=http://localhost:3000,http://127.0.0.1:3000
DESATIVAR_DOCUMENTACAO_API=0

# Guardas determinísticas do agente
ANUNCIO_MAX_QUANTIDADE_KG=10000
MARGEM_PRECO=25
USAR_EXEMPLOS=0


