# ==============================================================================
# nonglink-agent - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este ficheiro para .env antes de iniciar com Docker ou localmente:
#   cp .env.example .env
# Nunca comite ficheiros .env com chaves reais para o repositório.
# ==============================================================================

# Chave de autenticação da Meta Model API (https://api.meta.ai/v1)
# Obrigatória em produção / demonstração real. Não inclua em imagens Docker.
MODEL_API_KEY=coloque_a_sua_chave_aqui

# Endereço público da API FastAPI consumido pelo front-end Next.js no browser
# Por omissão para Docker local: http://127.0.0.1:8000 (ou o URL público de produção)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Porta do serviço backend (padrão: 8000) e frontend (padrão: 3000)
PORT=8000

# Diretório de armazenamento persistente para SQLite e uploads (no contentor: /data)
DATA_DIR=/data

# Modo da plataforma integrada: 'sandbox' (simulação local) ou 'api' (backend NongLink real)
MODO_PLATAFORMA=sandbox
NONGLINK_API_URL=http://127.0.0.1:8000/api/v1

# Controlo de documentação da API FastAPI (1 = activa /docs e /openapi.json; 0 = desactiva com 404)
ENABLE_DOCS=1
DESATIVAR_DOCUMENTACAO_API=0

# Lista de origens permitidas pelo CORS (separadas por vírgula; nunca use "*")
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGENS_PERMITIDAS=http://localhost:3000,http://127.0.0.1:3000

# Modo de manutenção de emergência (1 para ativar erro 503 nas rotas que invocam o modelo)
MODO_MANUTENCAO=0

# Quotas diárias de chamadas à Meta Model API (/agente, /voz, /foto)
QUOTA_DIARIA_CONVIDADO=15
QUOTA_DIARIA_REGISTADO=40
QUOTA_DIARIA_GLOBAL=400

# Limite de criação de contas de demonstração por IP (/auth/demo - máx por hora)
AUTH_DEMO_MAX_POR_IP_HORA=5

# Limites de tamanho de upload de ficheiros (validados no servidor)
UPLOAD_MAX_IMAGEM_BYTES=5242880
UPLOAD_MAX_AUDIO_BYTES=2097152
UPLOAD_MAX_AUDIO_SEGUNDOS=60

# Períodos de retenção e limpeza automática de dados
RETENCAO_CONVIDADO_HORAS=24
RETENCAO_REGISTADO_DIAS=30

# Guardas determinísticas do agente de campo
ANUNCIO_MAX_QUANTIDADE_KG=10000
MARGEM_PRECO=25
USAR_EXEMPLOS=0
