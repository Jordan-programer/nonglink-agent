# ==============================================================================
# nonglink-agent - Variáveis de Ambiente (.env.example)
# Copie este ficheiro para .env antes de iniciar com Docker ou localmente:
#   cp .env.example .env
# Nunca comite ficheiros .env com chaves reais para o repositório público.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta Model API (Obrigatória para IA multimodal)
# ------------------------------------------------------------------------------
# Chave de autenticação Bearer para https://api.meta.ai/v1
# Utilizada pelos modelos muse-spark-1.3, muse-voice-transcribe-1.0 e sam-3.1
MODEL_API_KEY=coloque_a_sua_chave_meta_aqui

# ------------------------------------------------------------------------------
# 2. Modo de Plataforma e Integração com NongLink
# ------------------------------------------------------------------------------
# 'sandbox': Simulação local isolada em SQLite para demonstração/testes rápidos
# 'api': Modo de produção como cliente do ecossistema NongLink (agrilink.store)
MODO_PLATAFORMA=sandbox

# URL base da API REST do NongLink (apenas relevante quando MODO_PLATAFORMA=api)
# Em produção no servidor VPS: http://127.0.0.1:8000/api/v1 ou https://agrilink.store/api/v1
NONGLINK_API_URL=https://agrilink.store/api/v1

# URL de redirecionamento para agricultores criarem conta na plataforma principal
NONGLINK_REGISTER_URL=https://agrilink.store/registar

# Quota máxima diária de análises de satélite GEE por agricultor (padrão: 3)
SOLO_MAX_POR_UTILIZADOR_DIA=3

# ------------------------------------------------------------------------------
# 3. Portas e Endereço Público
# ------------------------------------------------------------------------------
# Porta do serviço backend FastAPI (padrão local: 8000; contentor de produção: 8200)
PORT=8000

# Endereço público da API do agente consumido pelo frontend Next.js no browser
# Em desenvolvimento local: http://127.0.0.1:8000
# Em produção: https://agent.agrilink.store/api (ou URL do backend reverso)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Diretório de persistência para SQLite e uploads (no contentor: /data)
DATA_DIR=/data

# ------------------------------------------------------------------------------
# 4. Segurança, CORS e Manutenção
# ------------------------------------------------------------------------------
# Origens permitidas pelo CORS (separadas por vírgula; nunca use "*")
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3200,https://agent.agrilink.store
CORS_ORIGENS_PERMITIDAS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3200,https://agent.agrilink.store

# Controlo de documentação da API FastAPI (1 = activa /docs; 0 = desactiva com 404)
ENABLE_DOCS=1
DESATIVAR_DOCUMENTACAO_API=0

# Modo de manutenção de emergência (1 activa erro 503 com mensagem amigável)
MODO_MANUTENCAO=0

# Quotas diárias de chamadas à Meta Model API (/agente, /voz, /foto)
QUOTA_DIARIA_CONVIDADO=15
QUOTA_DIARIA_REGISTADO=40
QUOTA_DIARIA_GLOBAL=400

# Limite de criação de contas demo por IP por hora (apenas modo sandbox)
AUTH_DEMO_MAX_POR_IP_HORA=5

# ------------------------------------------------------------------------------
# 5. Limites de Upload e Ficheiros
# ------------------------------------------------------------------------------
UPLOAD_MAX_IMAGEM_BYTES=5242880
UPLOAD_MAX_AUDIO_BYTES=2097152
UPLOAD_MAX_AUDIO_SEGUNDOS=60

# Retenção de dados temporários
RETENCAO_CONVIDADO_HORAS=24
RETENCAO_REGISTADO_DIAS=30

# Guardas determinísticas de mercado
ANUNCIO_MAX_QUANTIDADE_KG=10000
MARGEM_PRECO=0.50
USAR_EXEMPLOS=0

# ------------------------------------------------------------------------------
# 6. Teste de Integração Real (Opcional - Usado em scripts/teste_real_nonglink.py)
# ------------------------------------------------------------------------------
TEST_REAL_NONGLINK=0
TESTE_EMAIL=meta@test.com
TESTE_SENHA=meta@123
